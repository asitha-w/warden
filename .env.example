# Copy to .env and fill in. Without ANTHROPIC_API_KEY the app runs in scripted mode.
ANTHROPIC_API_KEY=
WARDEN_MODEL=claude-opus-5-5
WARDEN_ADDR=:8080
# simulation tick in ms (one metric sample per tick)
WARDEN_TICK_MS=1000
# pause between scripted playbook steps in ms
WARDEN_PACE_MS=900
# dev mode: serve the console from this directory instead of the embedded copy
# WARDEN_WEB_DIR=web
